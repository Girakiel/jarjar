{
  "name": "jarjar",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, open-source behavior analytics: session recordings, heatmaps and feedback.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@rrweb/record": "^2.2.0",
    "@rrweb/replay": "^2.2.0",
    "@rrweb/types": "^2.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "rrweb-player": "^2.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "dev": "concurrently -k -n server,tracker,dashboard -c blue,magenta,green \"npm:dev:server\" \"npm:dev:tracker\" \"npm:dev:dashboard\"",
    "dev:server": "tsx watch --clear-screen=false --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:tracker": "node scripts/build.mjs tracker --watch",
    "dev:dashboard": "vite",
    "build": "node scripts/build.mjs all && vite build",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts"
  }
}
